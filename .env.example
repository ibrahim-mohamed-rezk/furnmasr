# ---------------------------------------------------------------------------
# Furnmasr storefront — local development
#
# TODO(furnmasr): this still points at the Ghofran staging API. Swap both URLs
# for the Furnmasr backend once it is live, and update the image remotePatterns
# in next.config.js to match the new image host.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://ghoran.test-domain-devunity.com/api
NEXT_PUBLIC_API_BASE_URL=https://ghoran.test-domain-devunity.com/api

# Canonical public origin. Used for canonical URLs, hreflang, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://furnmasr.com

NEXTAUTH_URL=http://localhost:3011

# Session signing key — generated fresh for this project.
AUTH_SECRET=
NEXTAUTH_SECRET=

# TODO(furnmasr): these are the Ghofran OAuth apps, kept so social login keeps
# working against the shared staging API. Register Furnmasr apps on the Meta and
# Google consoles and replace all four values before going live. The callback
# URLs to register are https://furnmasr.com/api/auth/callback/{google,facebook}.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
